// Copy to Config/Local.xcconfig (gitignored) and fill in.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Supabase host without scheme. Hosted project: abcdefghij.supabase.co (https).
// Local stack reached from an iPhone on the same Wi-Fi: host[:port] of this Mac, e.g.
// 192.168.1.20:54321 or my-mac.local:54321 (LAN IP: `ipconfig getifaddr en0`; on a 172.16-31.x
// network use `$(scutil --get LocalHostName).local:54321`). Hosts starting with 127., localhost,
// 192.168., 10. or containing .local are reached over http. The anon key for the local stack
// comes from `supabase status -o env` (ANON_KEY).
SUPABASE_HOST =
SUPABASE_ANON_KEY =

// Optional: the dictation server's host (server/README.md), e.g. api.simplymurmur.com, or
// 192.168.1.20:8080 for one running on this Mac. Dictations go to it first and to the Supabase
// functions when it fails or is slow. Leave it out to use the Supabase functions alone.
// MURMUR_EDGE_HOST =
