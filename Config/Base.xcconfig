// Shared build settings for every Murmur target.
// Per-machine values (team, backend keys) go in Local.xcconfig, which is gitignored.
// Copy Local.xcconfig.example to Local.xcconfig to get started.

// Branding — rename the app by changing these (plus Brand.swift).
MURMUR_APP_NAME = Murmur
MURMUR_BUNDLE_PREFIX = com.antonmironenko
MURMUR_URL_SCHEME = murmur
MURMUR_APP_GROUP = group.$(MURMUR_BUNDLE_PREFIX).murmur
// The website (scripts/publish_site.sh): the legal pages linked from sign-in, the paywall and
// Account, the Help center, and the page invite links open. `//` starts a comment here, so write
// https:/$()/example.com/terms.
MURMUR_TERMS_URL = https:/$()/alexeimiro.github.io/AI_dictation/terms/
MURMUR_PRIVACY_URL = https:/$()/alexeimiro.github.io/AI_dictation/privacy/
MURMUR_SUPPORT_URL = https:/$()/alexeimiro.github.io/AI_dictation/support/
MURMUR_INVITE_URL = https:/$()/alexeimiro.github.io/AI_dictation/invite/

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 2
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
DEVELOPMENT_TEAM =

// Signing. Simulator/default builds use automatic signing. scripts/device_build.sh switches to
// manual signing with the development profiles created by scripts/provision_dev.mjs;
// scripts/testflight_upload.sh uses the App Store profiles and Apple Distribution.
MURMUR_SIGN_STYLE = Automatic
MURMUR_SIGN_IDENTITY = Apple Development
MURMUR_PROFILE_APP =
MURMUR_PROFILE_KEYBOARD =
MURMUR_PROFILE_WIDGETS =

// Backend. xcconfig treats `//` as a comment, so store the host only (e.g. abcd.supabase.co).
SUPABASE_HOST =
SUPABASE_ANON_KEY =

#include? "Local.xcconfig"
